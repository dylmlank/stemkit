# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required, and only for agent.py.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# STEMKIT_MODEL=claude-opus-5
# STEMKIT_PROJECTS=E:\stemkit\projects
# STEMKIT_DEMUCS_MODEL=htdemucs_6s      # or htdemucs for the faster 4-stem split
# STEMKIT_DEVICE=auto                   # auto | cuda | cpu
# STEMKIT_FFMPEG=ffmpeg
# STEMKIT_FFPROBE=ffprobe
# STEMKIT_YTDLP=yt-dlp
